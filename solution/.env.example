# Copy this file to .env and fill in values. Do not commit .env.
#   cp .env.example .env
#
# Keys are optional. Without OPENAI_API_KEY or VOCAREUM_API_KEY the
# classifier and resolver use heuristics + RAG.

# --- LLM (pick one) ---
OPENAI_API_KEY=voc-148592553116695052905726a72924422d8e1.66372792"
VOCAREUM_API_KEY=voc-148592553116695052905726a72924422d8e1.66372792"
# Used with Vocareum when OPENAI_API_KEY is empty. Default:
# OPENAI_BASE_URL=https://openai.vocareum.com/v1
OPENAI_BASE_URL=https://openai.vocareum.com/v1
UDA_MODEL=gpt-4o-mini

# 1 = never call the LLM (tests / offline). 0 = use LLM when a key is set.
UDA_USE_HEURISTIC=1

# --- App ---
UDA_THREAD_ID=demo-ticket

# 1 = load tools from FastMCP stdio servers. 0 = in-process Python tools.
USE_MCP=0

# --- Paths (optional overrides; defaults are under this solution folder) ---
# SOLUTION_ROOT=
# CULTPASS_DB=
# UDAHUB_DB=
# MEMORY_DB=
